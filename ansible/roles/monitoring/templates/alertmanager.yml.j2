---
# Rendered by Ansible for {{ inventory_hostname }}
global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'service']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'webhook-receiver'

receivers:
  - name: 'webhook-receiver'
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
